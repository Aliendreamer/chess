node_modules/
.nx/
dist/
.output/
coverage/
TestResults/
bin/
obj/
*.log
.env
.env.*
!.env.example

# app build outputs
# Tauri: the Rust build and the Stockfish sidecar fetched by tools/desktop/fetch-stockfish.mjs
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/gen/
.output/
.nitro/
.tanstack/
test-results/
playwright-report/

# Claude Code harness scratch
**/.claude/.cc-writes/

# superpowers SDD scratch
.superpowers/

# pnpm's content-addressable store when it falls back to a project-local path (the agent sandbox
# cannot reach ~/.local/share/pnpm/store). Pure cache — safe to delete, never committed.
.pnpm-store/

# Sandbox masks: inside the Claude Code sandbox these appear as empty files/devices in the repo root
# and error on read. They are the agent's own config and the user's shell dotfiles, not this project's.
.mcp.json
.gitconfig
.gitmodules
.ripgreprc
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.idea
.claude/loop.md
.claude/launch.json
.claude/scheduled_tasks.json
.claude/agents
.claude/hooks
.claude/output-styles
.claude/routines
.claude/workflows

# The same masks appear under any directory a command ran in; only the repo-root .claude/ is real.
apps/*/.claude/

# Playwright sessions saved by apps/frontend/e2e/auth.setup.ts (live cookies)
apps/frontend/e2e/.auth/

# A Stockfish archive left from before stockfish-pinned-download (GPLv3 binary, ~80 MB): never committed. The image
# downloads its pinned release itself, so the folder is unused and may be deleted.
apps/engine/stockfish/

.claude/worktrees
.claude/settings.local.json
