{
  "name": "engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/engine",
  "tags": ["scope:engine", "lang:dotnet"],
  "release": {
    "version": {
      "versionActions": "./tools/nx-release/dotnet-version-actions.cjs",
      "manifestRootsToUpdate": ["apps/engine"]
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet"],
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"],
      "options": {
        "cwd": "apps/engine",
        "command": "dotnet build Chess.Engine.csproj -c Release"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet"],
      "outputs": ["{projectRoot}/Chess.Engine.Tests/TestResults"],
      "options": {
        "cwd": "apps/engine",
        "command": "dotnet test Chess.Engine.Tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet", "{projectRoot}/.editorconfig"],
      "options": {
        "cwd": "apps/engine",
        "command": "dotnet format Chess.Engine.slnx --verify-no-changes --no-restore"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/engine",
        "command": "dotnet format Chess.Engine.slnx"
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh engine"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh engine local"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'deploy target not implemented: take the tag printed by `nx push engine` and roll the Docker service' && exit 1"
      }
    }
  }
}
