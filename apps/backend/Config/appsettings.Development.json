{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }]
  },
  "Keycloak": {
    "Authority": "http://keycloak.chess.localhost/realms/chess",
    "Audience": "",
    "ClientId": "chess_api",
    "ClientSecret": "chess-dev-secret",
    "CallbackUri": "http://app.chess.localhost/api/auth/callback",
    "PostLogoutRedirectUri": "http://app.chess.localhost",
    "AppBaseUrl": "http://app.chess.localhost"
  },
  "SessionCookies": {
    "Domain": ".chess.localhost"
  },
  "AllowedCorsOrigins": ["http://app.chess.localhost", "http://localhost:3000"],
  "ForwardedHeaders": {
    "KnownNetworks": ["172.30.0.0/24"]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=chess;Username=chess;Password=chess",
    "PostgresReplica": "Host=localhost;Port=5433;Database=chess;Username=chess;Password=chess",
    "Redis": "localhost:6379"
  }
}
