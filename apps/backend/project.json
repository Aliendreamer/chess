{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend",
  "tags": ["scope:backend", "lang:dotnet"],
  "release": {
    "version": {
      "versionActions": "./tools/nx-release/dotnet-version-actions.cjs",
      "manifestRootsToUpdate": ["apps/backend"]
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet"],
      "outputs": ["{projectRoot}/bin", "{projectRoot}/obj"],
      "options": {
        "cwd": "apps/backend",
        "command": "dotnet build Chess.Backend.csproj -c Release"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet"],
      "outputs": ["{projectRoot}/Chess.Backend.Tests/TestResults"],
      "options": {
        "cwd": "apps/backend",
        "command": "./build_test.sh"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["dotnet", "{projectRoot}/.editorconfig"],
      "options": {
        "cwd": "apps/backend",
        "command": "dotnet format Chess.Backend.slnx --verify-no-changes --no-restore"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "dotnet format Chess.Backend.slnx"
      }
    },
    "migration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/backend",
        "command": "./build_migration.sh {args.name}"
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh backend"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools/deploy/build.sh backend local"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'deploy target not implemented: take the tag printed by `nx push backend` and roll the Docker service' && exit 1"
      }
    }
  }
}
