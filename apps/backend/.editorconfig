root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cs]
# Braces: Allman
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:error

# Namespaces / usings
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# Explicit types, not var
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error

# Naming: PascalCase members/types and private const/static readonly; _camelCase private instance fields.
# Rules are evaluated in order: the const/static rule must come before the general private-field rule.
dotnet_naming_rule.private_const_static_pascal.symbols = private_const_static_fields
dotnet_naming_rule.private_const_static_pascal.style = pascal
dotnet_naming_rule.private_const_static_pascal.severity = error
dotnet_naming_symbols.private_const_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_static_fields.required_modifiers = static

dotnet_naming_rule.private_const_pascal.symbols = private_const_fields
dotnet_naming_rule.private_const_pascal.style = pascal
dotnet_naming_rule.private_const_pascal.severity = error
dotnet_naming_symbols.private_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_const_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_const_fields.required_modifiers = const

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.pascal_members.symbols = members
dotnet_naming_rule.pascal_members.style = pascal
dotnet_naming_rule.pascal_members.severity = error
dotnet_naming_symbols.members.applicable_kinds = class,struct,interface,enum,property,method,event,namespace,delegate
dotnet_naming_style.pascal.capitalization = pascal_case

# Misc
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:error
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# EF Core writes these; they are not hand-edited and are excluded from coverage too.
[Data/Migrations/*.cs]
generated_code = true
charset = unset
dotnet_diagnostic.IDE0161.severity = none
