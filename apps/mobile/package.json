{
  "name": "chess-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The standalone chess app for one player on a phone: play the computer, learn, analyse, read the news (mobile-app).",
  "license": "GPL-3.0-or-later",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --tunnel --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint .",
    "check": "prettier --check .",
    "test": "jest",
    "check:pins": "node scripts/check-pins.js",
    "expo:doctor": "node scripts/expo-doctor.js"
  },
  "dependencies": {
    "@chess/core": "workspace:*",
    "@chess/local": "workspace:*",
    "@chess/view": "workspace:*",
    "expo": "57.0.31",
    "expo-constants": "57.0.22",
    "expo-dev-client": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "expo-doctor": "1.20.4",
    "globals": "17.12.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.8.4",
    "typescript": "6.0.3"
  }
}
