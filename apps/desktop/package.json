{
  "name": "chess-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "The standalone chess app for one player: play the computer, learn, analyse, read the news (desktop-app).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vite build",
    "tauri": "tauri",
    "test": "vitest run && node --test ../../tools/desktop/fetch-stockfish.test.mjs ../../tools/desktop/publish.test.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "prettier --check .",
    "fetch-stockfish": "node ../../tools/desktop/fetch-stockfish.mjs"
  },
  "dependencies": {
    "@chess/core": "workspace:*",
    "@chess/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.15",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-http": "2.8.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "@tauri-apps/plugin-shell": "2.4.0",
    "@tauri-apps/plugin-sql": "2.5.0",
    "lucide-react": "1.47.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/router-plugin": "1.168.18",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "chess.js": "1.4.0",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
