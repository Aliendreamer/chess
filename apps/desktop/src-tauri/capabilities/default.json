{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's window may reach (desktop-app D1): its own database, the bundled Stockfish, files the player picks, the news sources, links in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "sql:default",
    "sql:allow-execute",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/stockfish",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://www.fide.com/feed/"
        },
        {
          "url": "https://en.chessbase.com/feed"
        },
        {
          "url": "https://lichess.org/@/Lichess/blog.atom"
        },
        {
          "url": "https://theweekinchess.com/twic-rss-feed"
        },
        {
          "url": "https://lichess.org/api/broadcast/top*"
        }
      ]
    }
  ]
}
