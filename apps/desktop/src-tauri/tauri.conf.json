{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess",
  "version": "../package.json",
  "identifier": "io.github.aliendreamer.chess",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm fetch-stockfish && pnpm dev",
    "beforeBuildCommand": "pnpm fetch-stockfish && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chess",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "msi"],
    "category": "BoardGame",
    "shortDescription": "Play the computer, learn and analyse chess, offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/stockfish"],
    "resources": {
      "binaries/Copying.txt": "stockfish-licence/Copying.txt",
      "binaries/SOURCE.txt": "stockfish-licence/SOURCE.txt",
      "../LICENSE": "LICENSE"
    },
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Aliendreamer \u2014 MIT; Stockfish: GPLv3"
  }
}
