      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, actor) (rate(chess_actor_recovery_duration_seconds_bucket{service_instance_id=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "{{actor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
