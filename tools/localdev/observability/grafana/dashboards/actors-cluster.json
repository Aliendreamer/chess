        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (actor) (rate(chess_actor_passivations_total{service_instance_id=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{actor}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
